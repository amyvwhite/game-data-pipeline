# Copy to .env and fill in what you need. Never commit .env.

# --- Storage for raw JSON: "local" (default, writes to ./data) or "s3"
STORAGE_BACKEND=local
# DATA_DIR=./data

# --- S3 (only when STORAGE_BACKEND=s3)
# S3_BUCKET=your-bucket-name
# S3_PREFIX=game-data-pipeline
# AWS_REGION=ca-central-1
# Credentials: prefer `aws configure` / an IAM role. If you must use keys, set:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Postgres
# Local Python run against the docker-compose database:
DATABASE_URL=postgresql+psycopg://games:games@localhost:5432/games
# Used by docker-compose to create the database:
POSTGRES_USER=games
POSTGRES_PASSWORD=games
POSTGRES_DB=games

# --- Steam requests
STEAM_COUNTRY=ca
REQUEST_TIMEOUT_S=10
MAX_RETRIES=4
MIN_REQUEST_INTERVAL_S=1.5

# --- Alerts (leave empty to only log)
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Twitch (optional): viewers per game. Create an app at https://dev.twitch.tv/console
# and paste its Client ID and a Client Secret. Leave empty to skip Twitch.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
